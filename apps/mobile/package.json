{
  "name": "@erp/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "EduSphere School ERP — Parent, Student and Driver mobile apps (Expo / React Native)",
  "main": "index.js",
  "expo": {
    "install": {
      "//": "TypeScript is pinned at the monorepo root and shared with the API and web app; letting the SDK bump only this workspace would give the repo two compilers.",
      "exclude": [
        "typescript"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "dev:mobile": "expo start",
    "start:parent": "cross-env APP_VARIANT=parent expo start",
    "start:student": "cross-env APP_VARIANT=student expo start",
    "start:driver": "cross-env APP_VARIANT=driver expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "doctor": "npx expo-doctor",
    "apk": "node scripts/build-apk.mjs",
    "apk:install": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production"
  },
  "dependencies": {
    "@erp/shared": "*",
    "@expo/vector-icons": "^15.1.1",
    "@maplibre/maplibre-react-native": "^11.3.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@tanstack/react-query": "^5.101.4",
    "date-fns": "^4.4.0",
    "expo": "~57.0.14",
    "expo-application": "~57.0.2",
    "expo-build-properties": "~57.0.13",
    "expo-constants": "~57.0.12",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-location": "~57.0.11",
    "expo-notifications": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.11",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.7.2"
  }
}
