// ===========================================================================
// EduSphere School ERP — Database Schema
// PostgreSQL 16 + PostGIS 3.4
//
// Conventions
//   * Every tenant-owned table carries `tenantId` and, where the record belongs
//     to a physical campus, `branchId`. Row-level isolation is enforced by the
//     API's tenancy middleware and (optionally) by Postgres RLS policies
//     installed in `migrations/manual/rls.sql`.
//   * Location columns are stored as plain `Float` lat/lng so Prisma can read
//     them, and mirrored into a PostGIS `geography(Point,4326)` column by the
//     trigger in `migrations/manual/postgis.sql` for spatial indexing.
//   * Money is `Decimal(14,2)`. Never Float.
// ===========================================================================

generator client {
  provider = "prisma-client-js"
  // `relationJoins` makes Prisma resolve nested relations with a LATERAL JOIN
  // in a single statement instead of issuing one query per relation. Against a
  // database ~300ms away that is the difference between a list endpoint taking
  // 3 round trips and taking 1.
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres", "relationJoins"]
}

datasource db {
  provider = "postgresql"
  // Pooled connection for the application (PgBouncer on Neon).
  url      = env("DATABASE_URL")
  // Migrations need a direct connection: they take advisory locks and run DDL,
  // neither of which survives a transaction pooler. Falls back to DATABASE_URL
  // when unset, which is correct for a plain self-hosted Postgres.
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [postgis, pgcrypto, pg_trgm]
}

