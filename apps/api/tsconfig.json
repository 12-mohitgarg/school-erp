{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // `prisma/` is excluded from the build: the seed runs through tsx and lives
  // outside rootDir, which the compiler will not accept alongside src/.
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
