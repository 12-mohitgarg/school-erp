{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // `prisma/` is excluded from the build: the seed runs through tsx and lives
  // outside rootDir, which the compiler will not accept alongside src/.
  "include": ["src/**/*.ts"],
  // Tests and their setup are typechecked by `npm run typecheck` (which uses
  // tsconfig.test.json) but never compiled into dist — shipping them would put
  // vitest on the production import graph, where it is not a dependency.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/test/**"]
}
