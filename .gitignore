# Prisma
apps/api/prisma/migrations/dev.db*

# Uploads / local scratch space
#
# Anchored with a leading slash so they match ONLY these directories at the
# repo root. Unanchored, `storage/` matches a directory of that name at any
# depth — it was silently excluding apps/api/src/core/storage/, so
# cloudinary.ts never reached the repo and the API failed to boot elsewhere
# with "Cannot find module '../../core/storage/cloudinary.js'". Nothing warns
# you about this: `git add` skips ignored files without comment.
/uploads/
/tmp/
/storage/

# Expo / React Native — anchored for the same reason.
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
/android/
/ios/

# Misc
.turbo/
.cache/
