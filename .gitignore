# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Environment
#
# `.env` is ignored everywhere because apps/api/.env holds live secrets: the
# database URL, the JWT signing secrets, the AES key for the integration
# credential vault, and the payment/SMS/push provider keys. Committing it would
# burn all of them permanently, since git history keeps a file even after it is
# deleted.
.env
.env.local
.env.*.local
!.env.example

# The web app's env is the deliberate exception. Vite inlines every VITE_
# variable into the bundle it serves to the browser, so a VITE_ value is public
# by definition and cannot be a secret — including the Cloudinary cloud name
# and unsigned upload preset, which the browser needs in order to upload at
# all. Committing it means a clone builds and uploads with no setup step.
!apps/web/.env

