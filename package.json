{
  "name": "edusphere-school-erp",
  "version": "1.0.0",
  "private": true,
  "description": "EduSphere School ERP — unified academic, administrative, financial and student-safety platform",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev --workspace=@erp/api",
    "dev:web": "npm run dev --workspace=@erp/web",
    "build": "npm run build --workspace=@erp/shared && npm run build --workspace=@erp/api && npm run build --workspace=@erp/web",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=@erp/api",
    "db:migrate": "npm run db:migrate --workspace=@erp/api",
    "db:seed": "npm run db:seed --workspace=@erp/api",
    "db:studio": "npm run db:studio --workspace=@erp/api",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
